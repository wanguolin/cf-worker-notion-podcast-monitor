{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-worker-notion-podcast-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Only credentials are Secrets and must never be stored here.
  // Notion data source IDs are non-sensitive identifiers; deploy-button users
  // must replace them with IDs from their own duplicated template.
  // npx wrangler secret put NOTION_TOKEN --env finance-production
  // npx wrangler secret put MANUAL_TRIGGER_TOKEN --env finance-production
  "env": {
    "finance-production": {
      "name": "cf-worker-notion-podcast-monitor-finance-production",
      "secrets": {
        "required": [
          "NOTION_TOKEN",
          "MANUAL_TRIGGER_TOKEN"
        ]
      },
      "vars": {
        "ENV_NAME": "finance-production",
        // Identifiers, not credentials. Fork/deploy users must use the IDs from
        // their own duplicated Notion template, never the author's databases.
        "NOTION_MONITOR_DATA_SOURCE_ID": "6770eb15-6002-4bd9-8791-53f8fc968cab",
        "NOTION_EPISODE_DATA_SOURCE_ID": "c6518896-0a17-43bb-8f95-b88933d211cb",
        "RSS_WINDOW_HOURS": 26,
        "RSS_MAX_BYTES": 33554432,
        "RSS_CONNECT_TIMEOUT_MS": 15000,
        "RSS_TIMEOUT_MS": 300000,
        "RSS_MAX_REDIRECTS": 5,
        // 上限须保证最坏情况在软截止内单次尝试完成：全新单集成功路径为每集 4 次
        // 串行 ~1s Notion 请求（首次排重、写前复查、创建、创建后验证），另有 schema
        // 读取、父页更新、下载解析与退避余量；防止恶意 Feed 烧满预算堵塞串行队列。
        "RSS_MAX_WINDOW_ITEMS": 100,
        "MESSAGE_SOFT_DEADLINE_MS": 720000,
        // Non-empty allowlist enables real writes only for the listed feed hashes.
        "CANARY_FEED_HASHES": "",
        // Keep this equal to queues.consumers[1].queue when renaming resources.
        "FEED_TASKS_DLQ_NAME": "podcast-monitor-dlq-finance-production",
        "DRY_RUN": false
      },
      "triggers": {
        // Cloudflare Cron uses UTC: 00:00/08:00/16:00 UTC = 08:00/16:00/00:00 Asia/Shanghai.
        "crons": ["0 0,8,16 * * *"]
      },
      "limits": {
        "cpu_ms": 300000
      },
      "observability": {
        "enabled": true
      },
      "queues": {
        "producers": [
          {
            "binding": "FEED_TASKS_QUEUE",
            "queue": "podcast-monitor-feed-tasks-finance-production"
          }
        ],
        "consumers": [
          {
            "queue": "podcast-monitor-feed-tasks-finance-production",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 5,
            "dead_letter_queue": "podcast-monitor-dlq-finance-production",
            "max_concurrency": 1
          },
          {
            "queue": "podcast-monitor-dlq-finance-production",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 1
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "podcast-monitor-finance-production",
          "database_id": "38f5ee58-edbb-4108-b89b-f7cd64bd51e0",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
